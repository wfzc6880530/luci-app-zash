#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CONF=/var/etc/zashboard-nginx.conf
RUNDIR=/var/run/zashboard-nginx

valid_port() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

start_service() {
	local enabled listen_port controller_host controller_port
	config_load zashboard
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get listen_port main listen_port 8088
	config_get controller_host main controller_host 127.0.0.1
	config_get controller_port main controller_port 9090

	valid_port "$listen_port" || {
		logger -t zashboard "Invalid listen_port; refusing to start"
		return 1
	}
	valid_port "$controller_port" || {
		logger -t zashboard "Invalid controller_port; refusing to start"
		return 1
	}
	case "$controller_host" in
		''|*[!A-Za-z0-9.-]*)
			logger -t zashboard "Invalid controller_host; use an IPv4 address or hostname"
			return 1
			;;
	esac

	mkdir -p "$RUNDIR" /var/etc
	cat > "$CONF" <<EOF
worker_processes 1;
pid $RUNDIR/nginx.pid;
error_log stderr notice;
events {
	worker_connections 256;
}
http {
	access_log /var/log/zashboard-nginx-access.log;
	server {
		listen 0.0.0.0:$listen_port;
		server_name _;
		client_max_body_size 2m;
		location / {
			proxy_pass http://$controller_host:$controller_port;
			proxy_http_version 1.1;
			proxy_set_header Host \$http_host;
			proxy_set_header X-Real-IP \$remote_addr;
			proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto \$scheme;
			proxy_set_header Upgrade \$http_upgrade;
			proxy_set_header Connection "upgrade";
			proxy_read_timeout 3600s;
			proxy_send_timeout 3600s;
		}
	}
}
EOF
	/usr/sbin/nginx -t -c "$CONF" -p "$RUNDIR/" || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/nginx -c "$CONF" -p "$RUNDIR/" -g "daemon off;"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger zashboard
}
